# Minimal, version-pinned baseline for a Tiny Tapeout-compatible OpenLane flow.
# OpenLane is in maintenance mode; LibreLane is its backwards-compatible successor.
export LIBRELANE_VERSION="3.0.14"
export LIBRELANE_CONTAINER_IMAGE="ghcr.io/librelane/librelane@sha256:f91b21d75f79871f9ccf37451020b5d2f7b3236881a997ff709c561e8280a30f"
export LIBRELANE_IMAGE_OVERRIDE="$LIBRELANE_CONTAINER_IMAGE"
export PDK="sky130A"
export SKY130_PDK_REVISION="8afc8346a57fe1ab7934ba5a6056ea8b43078e71"
export STD_CELL_LIBRARY="sky130_fd_sc_hd"
export PDK_ROOT="${PDK_ROOT:-$HOME/.ciel}"
